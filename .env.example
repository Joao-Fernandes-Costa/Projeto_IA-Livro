# ==============================================================================
# EstudaIA — Modelo de Variáveis de Ambiente (Template)
# ==============================================================================
# Este arquivo é apenas um MODELO público de referência (sem chaves reais).
# Para usar suas chaves privadas, copie este arquivo para .env.local:
#   cp .env.example .env.local
#
# O arquivo .env.local é protegido pelo .gitignore e NUNCA é enviado ao git.
# Nunca utilize o prefixo NEXT_PUBLIC_ para chaves de API secretas.
# O provider padrão 'mock' funciona localmente sem necessidade de nenhuma chave.

# Provider de IA padrão ("mock", "ollama", "openrouter", "openai", "gemini", "custom")
AI_PROVIDER=mock
AI_MODEL=

# 1. Ollama Local (execução 100% local e gratuita)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# 2. OpenRouter (múltiplos modelos via API unificada)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5

# 3. OpenAI Oficial
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Google Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 5. Provider Personalizado compatível com OpenAI (ex: 9Router Proxy, vLLM, LM Studio)
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=
CUSTOM_OPENAI_NAME=9Router Proxy

# ==============================================================================
# 6. Painel Administrativo e Criptografia de Chaves
# ==============================================================================
# Senha de acesso ao painel administrativo (/admin/configuracoes/ia)
AI_ADMIN_PASSWORD=

# Chave secreta para criptografia AES-256-GCM dos segredos salvos no servidor (mínimo 32 caracteres)
AI_SETTINGS_ENCRYPTION_KEY=
